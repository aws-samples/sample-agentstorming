# Copy to .env and fill in.
# AWS credentials usually come from ~/.aws/credentials or env vars; no need to put them here.

# Optional: HuggingFace token for gated datasets (GPQA Diamond).
HF_TOKEN=

# Primary Bedrock model (inference profile id).
AGENTSTORMING_BENCH_MODEL=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# Concurrency for Bedrock calls. Bedrock Converse default quota is 20 rpm per account/region;
# keep well below to avoid throttle.
AGENTSTORMING_BENCH_CONCURRENCY=8

# Logging
AGENTSTORMING_BENCH_LOG_LEVEL=INFO

# Storm server URL. Leave unset to spin up an in-process ephemeral server per benchmark run.
# AGENTSTORM_SERVER_URL=http://localhost:8080
