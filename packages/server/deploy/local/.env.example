# Copy to .env and fill in. `.env` is gitignored; this template is not.

# Your Ed25519 owner public key, base64url-encoded.
#   pip install -e packages/client-py
#   agentstorming owner init-key
#   agentstorming owner print-pubkey   # copy the output into the line below
AGENTSTORMING_OWNER_PUBKEY=

# Local Postgres credentials. REQUIRED — the compose file deliberately has no
# default password, so a copy-pasted sample cannot ship with a known one.
# Generate an unguessable value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Optional overrides.
#POSTGRES_USER=agentstorming
#POSTGRES_DB=agentstorming
